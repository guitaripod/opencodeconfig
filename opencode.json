{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-server/qwen38-nvfp4",
  "small_model": "llama-server/qwen38-nvfp4",
  "permission": "allow",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 65536
  },
  "mcp": {
    "appstore-connect": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@pofky/asc-mcp"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "ASC_KEY_ID": "DSS2FFU68G",
        "ASC_ISSUER_ID": "a5ebdab5-0ceb-463c-8151-195b902f117b",
        "ASC_PRIVATE_KEY_PATH": "{env:HOME}/.appstoreconnect/private_keys/AuthKey_DSS2FFU68G.p8"
      }
    },
    "flyr": {
      "type": "local",
      "command": [
        "flyr",
        "mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "kimi-code": {
      "npm": "@ai-sdk/anthropic",
      "name": "Kimi Code",
      "options": {
        "baseURL": "https://api.kimi.com/coding/v1",
        "apiKey": "{env:KIMI_CODE_KEY}"
      },
      "models": {
        "k3": {
          "name": "Kimi K3"
        }
      }
    }
  }
}
