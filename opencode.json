      },
      "models": {
        "qwen38-nvfp4": {
          "name": "Qwen 3.8 27B · NVFP4 · MTP · llama.cpp",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "think": {
              "chat_template_kwargs": {
                "enable_thinking": true
